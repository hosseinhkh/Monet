# Copy to env.local (git-ignored) for machine-specific settings; read by scripts/*.sh and `python -m monet_action.*`.
# Variables already exported in your shell take precedence.
GPU_ID=0                    # card as numbered by nvidia-smi; "auto" = most free memory
MONET_GPU_RESERVE=0.5       # each run claims 50% of that card before loading anything, and is capped there
# MONET_GPU_LIMIT=0.5       # optional: different cap than the reservation (0 disables the cap)
# MONET_MIN_FREE_GB=40      # preflight: minimum free memory on the selected card
# HF_HOME=/data/huggingface # where Monet-7B is cached
MONET_GPU_HOLD=1            # keep that 50% claimed between runs (background holder; bash scripts/gpu_hold.sh stop)
